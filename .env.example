# Copy to .env and edit. Real environment variables override this file.
APP_ENV=development                 # set to "production" to enforce the checks below

# --- Security (REQUIRED in production) ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
ADMIN_USERNAME=admin
# First-run admin password. If empty (development only) a random one is generated and printed once.
ADMIN_PASSWORD=
# Let visitors create their own account on the login page (always a read-only Viewer; an Admin can upgrade them).
# Admins can also switch this on/off at runtime in Admin > Settings.
ALLOW_SELF_REGISTRATION=true
# Comma-separated list of browser origins allowed to call the API (no wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# --- Storage ---
DB_PATH=./data/cyberwatch.db
MODEL_DIR=./models/active
RETENTION_DAYS=14

# --- Detection ---
DEDUPE_WINDOW_SECONDS=300           # repeated detections from one source within this window become one alert
CRITICAL_ASSETS=10.0.0.10,10.0.0.20 # destinations that raise the risk score of attacks against them

# --- Simulator & uploads ---
SIMULATION_ENABLED=true
SIMULATION_INTERVAL=1.0
SIMULATION_ATTACK_RATIO=0.12
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=200000

# --- Connectors (live log ingestion) ---
INGEST_MAX_BATCH=500                # events per request
INGEST_MAX_BODY_BYTES=1000000
INGEST_EVENTS_PER_SECOND=1000       # sustained rate per source
SOURCE_SILENT_AFTER_SECONDS=150     # no heartbeat/events for this long => the source is "silent"
WEB_MODEL_DIR=./models/web
# Docker LAB ONLY (refused when APP_ENV=production): registers a source with a fixed, public key
# ARGUS_BOOTSTRAP_SOURCE_KEY=
# ARGUS_BOOTSTRAP_SOURCE_NAME=Lab web server

# --- Email alerts (disabled unless SMTP_HOST and ALERT_EMAIL_TO are set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=argus@localhost
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_SEVERITY=High
